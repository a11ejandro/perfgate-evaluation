{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/perfgate-evaluation/study-plan-v1.schema.json",
  "title": "Perfgate evaluation study plan",
  "type": "object",
  "required": [
    "schema_version", "study_id", "stage", "generated_at",
    "subject", "perfgate_revision", "perfgate_runtime_source_digest", "environment_class",
    "reference_design", "estimator", "analysis", "trials"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "study_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["calibration", "held_out"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "required": ["repository", "reference_revision", "configuration_digest", "workload_source_digests"],
      "additionalProperties": true
    },
    "perfgate_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "perfgate_runtime_source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "environment_class": { "type": "string", "minLength": 1 },
    "reference_design": { "const": "historical_stored_baseline" },
    "estimator": { "const": "independent_nonparametric_bootstrap_median_difference" },
    "analysis": { "type": "object" },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "trial_id", "condition", "condition_kind", "repetition",
          "reversal_pair", "reference_revision", "candidate_revision",
          "execution_sequence"
        ],
        "properties": {
          "trial_id": { "type": "string", "minLength": 1 },
          "execution_sequence": { "const": ["reference", "candidate"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
